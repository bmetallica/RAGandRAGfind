PORT=3311
DATABASE_URL=postgresql://user:password@rag-db:5432/rag_db
REDIS_URL=redis://redis:6379
# Seed values for the AI provider configuration - only used to populate the
# `ai_provider_settings` table on first startup against an empty database.
# Afterwards, the running configuration is managed via Admin-UI -> Config-AI
# and changes to these variables have no further effect.
OLLAMA_BASE_URL=http://192.168.66.225:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=gptoss-20b
DOCUMENT_CLASSIFIER_MODEL=qwen2.5:7b
EMBEDDING_DIMENSION=768
QUERY_TOP_K=5
QUERY_CANDIDATE_K=40
QUERY_MAX_CHUNKS_PER_DOCUMENT=2
QUERY_VECTOR_WEIGHT=0.65
QUERY_KEYWORD_WEIGHT=1.35
# Task-Prefixes fuer asymmetrische Embedding-Modelle. Leer = automatisch aus dem
# Modellnamen abgeleitet (nomic -> search_document:/search_query:, e5 -> passage:/query:).
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=
# Zeichenbudget je Embedding-Request. Verhindert, dass ein zu langer Input vom
# Embedding-Server abgelehnt wird (llama.cpp: ubatch, Default 512 Token
# ~= 1550 Zeichen deutscher Text). 0 = kein Limit.
EMBEDDING_MAX_INPUT_CHARS=1400
# Cross-Encoder-Reranker (llama.cpp mit --reranking, TEI, Infinity, vLLM).
# Nur Seed-Werte fuer eine leere Datenbank - danach im Admin-UI unter Config-AI pflegen.
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_ENABLED=false
RERANKER_TOP_N=12
# Zeichen je Kandidat, die an den Reranker gehen. Wie EMBEDDING_MAX_INPUT_CHARS
# begrenzt durch die ubatch-Groesse des Reranking-Servers.
RERANKER_DOCUMENT_MAX_CHARS=900
RERANKER_TIMEOUT_MS=10000
RERANKER_CONCURRENCY=2
QUERY_EXACT_MATCH_BOOST=0.2
QUERY_RERANK_TOP_N=12
QUERY_SMALL_TO_BIG_WINDOW=1
# Zeichenfenster fuer den unscharfen (Trigramm-) Dokumentabgleich. Exakte
# Treffer nutzen weiterhin die vollen 16k Zeichen. 0 = kein Fenster.
QUERY_FUZZY_TEXT_WINDOW=4000
CHUNK_SIZE=300
CHUNK_OVERLAP=50
IMPORT_DIR=/app/import-dir
# Ein Unterverzeichnis von IMPORT_DIR je Wissensdatenbank (Ordnername = Slug).
# Gilt nur fuer Syncs ohne explizit gewaehlte Wissensdatenbank.
SYNC_KNOWLEDGE_BASE_SUBDIRS=true
# Legt eine Wissensdatenbank an, wenn ein Unterverzeichnis noch keine hat.
SYNC_AUTO_CREATE_KNOWLEDGE_BASES=true
UPLOAD_DIR=/app/data/uploads
ORIGINAL_STORAGE_DIR=/app/data/originals
GIT_REPO_CACHE_DIR=/app/data/git-repos
GIT_REPO_MAX_FILE_BYTES=1000000
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_PREFIX=rag
PUBLIC_BASE_URL=http://localhost:3311
CRAWL_DEFAULT_MAX_DEPTH=2
SYNC_CRON=*/30 * * * *
LOG_LEVEL=info
